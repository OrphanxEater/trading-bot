# Solana Network Configuration
SOLANA_RPC_ENDPOINT="https://api.mainnet-beta.solana.com"
SOLANA_NETWORK="mainnet-beta"  # Options: mainnet-beta, devnet, testnet

# Wallet Configuration
# Your private key in base58 format or JSON array format
# To get your private key from Phantom: Settings > Export Private Key
# From Solana CLI: cat ~/.config/solana/id.json
PRIVATE_KEY="your-base58-private-key-here"

# Trading Pair Configuration
# Default: SOL/USDC
INPUT_TOKEN="So11111111111111111111111111111111111111112"  # SOL mint address
OUTPUT_TOKEN="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"  # USDC mint address

# Trading Parameters
TRADE_AMOUNT="0.1"           # Amount to trade in SOL (or input token)
SLIPPAGE_BPS="50"            # Slippage tolerance in basis points (50 = 0.5%)

# Strategy Configuration
STRATEGY="threshold"          # Options: threshold, dca, momentum, grid

# Threshold Strategy Settings
BUY_THRESHOLD="0"            # Buy when price drops to this value (0 = disabled)
SELL_THRESHOLD="0"           # Sell when price rises to this value (0 = disabled)
PRICE_CHECK_INTERVAL="10000" # Price check interval in milliseconds (10000 = 10 seconds)

# DCA (Dollar-Cost Averaging) Strategy Settings
DCA_AMOUNT="0.1"             # Amount to buy per interval
DCA_INTERVAL="3600000"       # Interval between purchases in milliseconds (3600000 = 1 hour)

# Momentum Strategy Settings
RSI_PERIOD="14"              # RSI calculation period
RSI_OVERSOLD="30"            # RSI oversold threshold (buy signal)
RSI_OVERBOUGHT="70"          # RSI overbought threshold (sell signal)
MOMENTUM_THRESHOLD="2.0"     # Minimum % price change to signal momentum
CONFIRMATION_REQUIRED="true" # Require multiple indicator confirmations
TRAILING_STOP_PERCENT="5.0"  # Trailing stop loss percentage

# Grid Trading Strategy Settings
GRID_LEVELS="10"             # Number of grid levels
GRID_SPACING="2.0"           # Spacing between grid levels (%)
GRID_UPPER_PRICE="0"         # Upper grid boundary (0 = auto-calculate)
GRID_LOWER_PRICE="0"         # Lower grid boundary (0 = auto-calculate)
GRID_ORDER_SIZE="0.01"       # Order size per grid level

# Risk Management Settings
ENABLE_RISK_MANAGEMENT="false"  # Enable advanced risk management
MAX_DRAWDOWN="0.2"              # Maximum drawdown (20% = 0.2)
MAX_POSITION_SIZE="0.25"        # Maximum position size (25% = 0.25)
KELLY_FRACTION="0.25"           # Fraction of Kelly criterion to use
MAX_DAILY_LOSS="0.1"            # Maximum daily loss limit (10% = 0.1)

# Performance Tracking
ENABLE_PERFORMANCE_TRACKING="true"  # Track performance metrics (Sharpe, win rate, etc.)

# Advanced Settings
PRIORITY_FEE="1000"          # Priority fee in microLamports (higher = faster confirmation)
MAX_RETRIES="3"              # Maximum retry attempts for failed operations
DRY_RUN="false"              # Set to "true" to test without executing real trades

# Logging
LOG_LEVEL="info"             # Options: debug, info, warn, error

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit your .env file to git
# 2. Keep your PRIVATE_KEY secure and never share it
# 3. Start with small amounts and test on devnet first
# 4. Always use DRY_RUN=true first to test your configuration
